# Copy to .env and fill with your own values.
# Never commit .env.

# Required: API credentials.
DASHSCOPE_API_KEY=replace_with_your_api_key

# Required: Embedding and Rerank compatible endpoint.
DASHSCOPE_BASE_URL=https://your-endpoint.example/compatible-mode/v1

# Chat model. Keep the original model unless intentionally changed.
QWEN_MODEL=qwen-plus

# Optional: set only if chat uses a different endpoint.
# QWEN_BASE_URL=https://your-chat-endpoint.example/compatible-mode/v1

# Required for protected FastAPI requests.
AGENT_DEV_API_KEY=replace_with_a_random_development_key
